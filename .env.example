# Copy this to .env.local and fill in your values
# Never commit .env.local to git

# Google Apps Script Web App URL (handles Sheets + Gmail)
REACT_APP_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Google Maps Embed API Key (optional – without it the embed still works)
REACT_APP_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_API_KEY
